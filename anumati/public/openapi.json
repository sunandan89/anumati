      "maxLength": 20,
      "type": "string"
     },
     "date_of_birth": {
      "maxLength": 10,
      "type": "string"
     },
     "email": {
      "maxLength": 140,
      "type": "string"
     },
     "full_name": {
      "maxLength": 140,
      "type": "string"
     },
     "is_minor": {
      "enum": [
       0,
       1,
       true,
       false,
       "0",
       "1"
      ]
     },
     "needs_assistance": {
      "enum": [
       0,
       1,
       true,
       false,
       "0",
       "1"
      ]
     },
     "no_phone": {
      "enum": [
       0,
       1,
       true,
       false,
       "0",
       "1"
      ]
     },
     "persona": {
      "maxLength": 40,
      "type": "string"
     },
     "phone": {
      "maxLength": 20,
      "type": "string"
     },
     "phone_owner_relation": {
      "maxLength": 40,
      "type": "string"
     },
     "preferred_language": {
      "maxLength": 10,
      "type": "string"
     },
     "principal_ref": {
      "maxLength": 140,
      "minLength": 1,
      "type": "string"
     },
