      "maxLength": 140,
      "type": "string"
     },
     "payload": {
      "maxLength": 5000,
      "type": "string"
     },
     "principal_ref": {
      "maxLength": 140,
      "type": "string"
     },
     "request_type": {
      "enum": [
       "withdrawal",
       "access",
       "correction",
       "erasure",
       "grievance",
       "nomination"
