    "required": [
     "principal_ref"
    ],
    "type": "object"
   },
   "RightsSubmit": {
    "additionalProperties": false,
    "properties": {
     "channel": {
      "enum": [
       "app",
       "hosted_page",
       "connector",
       "field_worker",
       "slip",
       "sms",
       "missed_call",
       "ivr",
       "whatsapp",
       "web",
       "email",
       "community",
       "api",
       "ussd"
      ],
      "type": "string"
     },
