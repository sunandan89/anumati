    "additionalProperties": false,
    "properties": {
     "channel": {
      "enum": [
       "app",
       "hosted_page",
       "connector",
       "field_worker",
       "slip",
       "sms",
       "missed_call",
       "ivr",
       "whatsapp",
       "web",
       "email",
       "community",
       "api",
       "ussd"
      ],
      "type": "string"
     },
     "paper_trail_number": {
      "maxLength": 140,
      "type": "string"
     },
     "payload": {
      "maxLength": 5000,
      "type": "string"
     },
     "principal_ref": {
      "maxLength": 140,
      "type": "string"
     },
     "request_type": {
      "enum": [
       "withdrawal",
       "access",
       "correction",
       "erasure",
       "grievance",
       "nomination"
