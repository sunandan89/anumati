       "slip",
       "sms",
       "missed_call",
       "ivr",
       "whatsapp",
       "web",
       "email",
       "community",
       "api",
       "ussd"
      ],
      "type": "string"
     },
     "device_id": {
      "maxLength": 140,
      "type": "string"
     },
     "device_time": {
      "maxLength": 40,
      "type": "string"
     },
     "event_uuid": {
      "maxLength": 64,
      "minLength": 8,
      "type": "string"
     },
