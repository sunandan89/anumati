      "maxLength": 40,
      "type": "string"
     },
     "phone": {
      "maxLength": 20,
      "type": "string"
     },
     "phone_owner_relation": {
      "maxLength": 40,
      "type": "string"
     },
     "preferred_language": {
      "maxLength": 10,
      "type": "string"
     },
     "principal_ref": {
      "maxLength": 140,
      "minLength": 1,
      "type": "string"
     },
     "profile": {
      "additionalProperties": {
       "maxLength": 140,
       "type": [
        "string",
        "integer",
        "null"
       ]
      },
      "maxProperties": 40,
      "propertyNames": {
       "pattern": "^[a-z0-9_]{1,64}$"
      },
      "type": "object"
     },
     "programme": {
      "maxLength": 140,
      "type": "string"
     },
     "pwd_guarded": {
      "enum": [
       0,
       1,
       true,
       false,
       "0",
       "1"
      ]
     },
     "shared_phone": {
      "enum": [
       0,
       1,
       true,
       false,
       "0",
       "1"
      ]
     }
