        "file": {
         "maxLength": 500,
         "type": "string"
        },
        "kind": {
         "maxLength": 40,
         "type": "string"
        },
        "sha256": {
         "pattern": "^[0-9a-f]{64}$",
         "type": "string"
        }
       },
       "required": [
        "file"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "gps": {
      "maxLength": 64,
      "type": "string"
     },
     "guardian_link": {
      "maxLength": 140,
      "type": "string"
     },
     "ip_address": {
      "maxLength": 64,
      "type": "string"
     },
     "language": {
      "maxLength": 10,
      "type": "string"
     },
     "notice": {
      "maxLength": 140,
      "type": "string"
     },
     "notice_completed": {
      "enum": [
       0,
       1,
       true,
       false,
       "0",
       "1"
      ]
     },
     "notice_delivery": {
      "enum": [
       "",
       "recording",
       "phone_voice",
       "read_aloud",
       "read_on_screen"
      ],
      "type": "string"
     },
     "principal_ref": {
      "maxLength": 140,
      "minLength": 1,
      "type": "string"
     },
     "programme": {
      "maxLength": 140,
      "minLength": 1,
      "type": "string"
     },
     "purposes": {
      "items": {
       "maxLength": 64,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     "source_system": {
      "maxLength": 140,
      "type": "string"
     },
