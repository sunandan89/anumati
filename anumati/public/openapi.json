  "securitySchemes": {
   "token": {
    "in": "header",
    "name": "Authorization",
    "type": "apiKey"
   }
  }
 },
 "info": {
  "description": "Open-source DPDP consent API. Auth: `Authorization: token <api_key>:<api_secret>`. Scopes are the API user's Frappe roles. Writes are idempotent on event_uuid.",
