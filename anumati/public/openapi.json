        "file"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "gps": {
      "maxLength": 64,
      "type": "string"
     },
     "guardian_link": {
      "maxLength": 140,
      "type": "string"
     },
     "ip_address": {
      "maxLength": 64,
      "type": "string"
     },
     "language": {
      "maxLength": 10,
      "type": "string"
     },
     "notice": {
      "maxLength": 140,
      "type": "string"
     },
     "principal_ref": {
      "maxLength": 140,
      "minLength": 1,
      "type": "string"
     },
     "programme": {
      "maxLength": 140,
      "minLength": 1,
      "type": "string"
     },
     "purposes": {
      "items": {
       "maxLength": 64,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     "source_system": {
      "maxLength": 140,
      "type": "string"
     },
     "verification_method": {
      "enum": [
       "server_otp",
       "device_sms_otp",
       "reverse_sms",
       "missed_call",
       "deferred",
       "evidence_only"
      ],
      "type": "string"
     },
     "witness": {
      "maxLength": 500,
      "type": "string"
     }
    },
    "required": [
     "event_uuid",
     "principal_ref",
     "programme",
     "channel"
    ],
    "type": "object"
   },
