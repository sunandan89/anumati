{
 "components": {
  "schemas": {
   "Artefact": {
    "properties": {
     "action": {
      "type": "string"
     },
     "chain_seq": {
      "type": "integer"
     },
     "consent_id": {
      "type": "string"
     },
     "event_uuid": {
      "type": "string"
     },
     "hash": {
      "type": "string"
     },
     "key_id": {
      "type": "string"
     },
     "server_time": {
      "type": "string"
     },
     "short_code": {
      "type": "string"
     },
     "signature": {
      "type": "string"
     },
     "verification_status": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "ConsentRecord": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "enum": [
       "grant",
       "refuse",
       "renew"
      ],
      "type": "string"
     },
     "capture_mode": {
      "enum": [
       "self_digital",
       "self_worker_device",
       "assisted_verbal",
       "assisted_thumbprint",
       "assisted_witnessed",
       "guardian_minor",
       "guardian_pwd",
       "paper"
      ],
      "type": "string"
     },
     "channel": {
      "enum": [
       "app",
       "hosted_page",
       "connector",
       "field_worker",
       "slip",
       "sms",
       "missed_call",
       "ivr",
       "whatsapp",
       "web",
       "email",
       "community",
       "api",
       "ussd"
      ],
      "type": "string"
     },
     "device_id": {
      "maxLength": 140,
      "type": "string"
     },
     "device_time": {
      "maxLength": 40,
      "type": "string"
     },
     "event_uuid": {
      "maxLength": 64,
      "minLength": 8,
      "type": "string"
     },
     "evidence": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "file": {
         "maxLength": 500,
         "type": "string"
        },
        "kind": {
         "maxLength": 40,
         "type": "string"
        },
        "sha256": {
         "pattern": "^[0-9a-f]{64}$",
         "type": "string"
        }
       },
       "required": [
        "file"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "gps": {
      "maxLength": 64,
      "type": "string"
     },
     "guardian_link": {
      "maxLength": 140,
      "type": "string"
     },
     "ip_address": {
      "maxLength": 64,
      "type": "string"
     },
     "language": {
      "maxLength": 10,
      "type": "string"
     },
     "notice": {
      "maxLength": 140,
      "type": "string"
     },
     "principal_ref": {
      "maxLength": 140,
      "minLength": 1,
      "type": "string"
     },
     "programme": {
      "maxLength": 140,
      "minLength": 1,
      "type": "string"
     },
     "purposes_denied": {
      "items": {
       "maxLength": 64,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     "purposes_granted": {
      "items": {
       "maxLength": 64,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     "source_system": {
      "maxLength": 140,
      "type": "string"
     },
     "verification_method": {
      "enum": [
       "server_otp",
       "device_sms_otp",
       "reverse_sms",
       "missed_call",
       "deferred",
       "evidence_only"
      ],
      "type": "string"
     },
     "verification_status": {
      "enum": [
       "recorded",
       "confirmed",
       "evidence_only"
      ],
      "type": "string"
     },
     "witness": {
      "maxLength": 500,
      "type": "string"
     }
    },
    "required": [
     "event_uuid",
     "principal_ref",
     "programme"
    ],
    "type": "object"
   },
   "ConsentWithdraw": {
