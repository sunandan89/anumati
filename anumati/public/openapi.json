    "additionalProperties": false,
    "properties": {
     "age_band": {
      "maxLength": 20,
      "type": "string"
     },
     "birth_year": {
      "maximum": 2100,
      "minimum": 1900,
      "pattern": "^(19|20)[0-9]{2}$",
      "type": [
       "integer",
       "string"
      ]
     },
     "date_of_birth": {
      "maxLength": 10,
      "type": "string"
     },
     "email": {
      "maxLength": 140,
      "type": "string"
     },
     "full_name": {
      "maxLength": 140,
      "type": "string"
     },
     "is_minor": {
      "enum": [
       0,
       1,
       true,
       false,
       "0",
       "1"
      ]
     },
     "needs_assistance": {
      "enum": [
       0,
       1,
       true,
       false,
       "0",
       "1"
      ]
     },
     "no_phone": {
      "enum": [
       0,
       1,
       true,
       false,
       "0",
       "1"
      ]
     },
