 "fields": [
  {
   "fieldname": "grievance_tab",
   "fieldtype": "Tab Break",
   "label": "Grievance"
  },
  {
   "description": "Staff behaviour grievances are seen by the DPO only",
   "fieldname": "category",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "What is it about?",
   "options": "used_without_consent\ndid_not_stop\nwrong_details\nshared_or_leaked\nstaff_behaviour\nrequest_not_answered\nsomething_else",
   "reqd": 1
  },
  {
   "fieldname": "about_request",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "Which request?",
   "mandatory_depends_on": "eval:doc.category=='request_not_answered'",
   "options": "Rights Request"
  },
  {
   "fieldname": "subject",
   "fieldtype": "Data",
   "label": "Subject"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "In their words"
  },
  {
   "fieldname": "evidence",
   "fieldtype": "Attach",
   "label": "Photo or document"
  },
  {
   "default": "web",
   "fieldname": "channel",
   "fieldtype": "Select",
   "label": "Came in by",
   "options": "field_worker\nslip\nsms\nmissed_call\nivr\nwhatsapp\nweb\nemail\ncommunity\napi\nussd",
   "reqd": 1
  },
  {
   "fieldname": "c1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "matched_principal",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Beneficiary",
   "options": "Data Principal"
  },
  {
   "fieldname": "raised_by_role",
   "fieldtype": "Select",
   "label": "Raised by",
   "options": "\nby_self\nby_guardian\nby_nominee\nby_field_worker\nby_staff"
  },
  {
   "default": "new_request",
   "fieldname": "status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Status",
   "options": "new_request\nwho_is_this\nworking_on_it\nwaiting_for_person\nrequest_answered\nrequest_closed"
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Assigned to",
   "options": "User"
  },
  {
   "default": "now",
   "fieldname": "received_on",
   "fieldtype": "Datetime",
   "label": "Received on",
   "reqd": 1
  },
  {
   "description": "Received on + the grievance days in Anumati Settings",
   "fieldname": "sla_due",
   "fieldtype": "Date",
   "in_list_view": 1,
   "label": "Reply by"
  },
  {
   "description": "Set when no final answer was given in time, or the person was not happy with it",
   "fieldname": "dpo_since",
   "fieldtype": "Datetime",
   "label": "With the DPO since",
   "read_only": 1
  },
  {
   "fieldname": "answer_section",
   "fieldtype": "Section Break",
   "label": "Answer"
  },
  {
   "description": "Chosen with the final answer (Reply to the person > Send final answer)",
   "fieldname": "outcome",
   "fieldtype": "Select",
   "in_standard_filter": 1,
   "label": "Outcome",
   "options": "\nput_right\npartly_put_right\nno_problem_found",
   "read_only": 1
  },
  {
   "description": "Never shown to the person",
   "fieldname": "internal_note",
   "fieldtype": "Small Text",
   "label": "What we did (internal)"
  },
  {
   "fieldname": "c2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "answer",
   "fieldtype": "Small Text",
   "label": "Final answer",
   "read_only": 1
  },
  {
   "fieldname": "answered_on",
   "fieldtype": "Datetime",
   "label": "Answered on",
   "read_only": 1
  },
  {
   "fieldname": "person_says",
   "fieldtype": "Select",
   "in_standard_filter": 1,
   "label": "Did it solve it?",
   "options": "\nsolved\nnot_happy",
   "read_only": 1
  },
  {
   "fieldname": "person_said_on",
   "fieldtype": "Datetime",
   "label": "Said on",
   "read_only": 1
  },
  {
   "fieldname": "detail_tab",
   "fieldtype": "Tab Break",
   "label": "Details"
  },
  {
   "fieldname": "sender_section",
   "fieldtype": "Section Break",
   "label": "Sender"
  },
  {
   "fieldname": "match_confidence",
   "fieldtype": "Percent",
   "label": "Match confidence"
  },
  {
   "description": "Beneficiary IDs sharing the sender's number; use 'Who is this for?' to pick one",
   "fieldname": "candidates",
   "fieldtype": "Small Text",
   "label": "Possible matches",
   "read_only": 1
  },
  {
   "description": "Salted hash of the sender's number; the number itself is not stored",
   "fieldname": "sender_hash",
   "fieldtype": "Data",
   "label": "Sender phone hash",
   "read_only": 1,
   "search_index": 1
  },
  {
   "description": "Set when the grievance arrives by email",
   "fieldname": "raised_by",
   "fieldtype": "Data",
   "label": "Sender email",
   "options": "Email"
  },
  {
   "fieldname": "paper_trail_number",
